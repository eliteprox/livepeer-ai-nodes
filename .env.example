# Optional overrides. ComfyPeer signs in and selects an orchestrator with
# none of these set. A blank value is not an override.

# Explicit orchestrator. Leave unset to use discovery.
# ORCHESTRATOR_URL=https://orchestrator.example:8936

# Fallback signer, used only when a workflow disables the ComfyPeer account.
# SIGNER_URL=http://localhost:8081

# Public OIDC client. Defaults are the production ComfyPeer app.
# PYMTHOUSE_ISSUER_URL=https://pymthouse.com/api/v1/oidc
# COMFYPEER_PUBLIC_CLIENT_ID=app_444013b9d984f62f5572a282

# Older aliases, used only when COMFYPEER_PUBLIC_CLIENT_ID is absent:
# PYMTHOUSE_PUBLIC_CLIENT_ID=
# PYMTHOUSE_CLIENT_ID=

# Staging catalog. Leave unset in production so the signer session supplies
# discovery and the node describes that inventory without an offerings host.
# COMFYPEER_DISCOVERY_URL=https://discovery.example/discovery
# COMFYPEER_OFFERINGS_URL=https://engine.example/v1/offerings
