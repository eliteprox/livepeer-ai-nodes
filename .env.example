# Example environment config for Livepeer network

# Orchestrator URL (required)
ORCHESTRATOR_URL=https://hky.eliteencoder.net:8936

# Signer URL used only when a workflow explicitly disables the ComfyPeer account
# (optional self-managed fallback)
SIGNER_URL=http://localhost:8081

# ComfyPeer's PymtHouse public OIDC client. This is an app_ identifier, NOT a
# secret. It must allow the device-code and refresh-token grants and the
# scopes "openid" and "sign:job". Leave third-party initiate login off.
PYMTHOUSE_ISSUER_URL=https://your-pymthouse.example/api/v1/oidc
COMFYPEER_PUBLIC_CLIENT_ID=app_your_comfypeer_public_client_id

# Legacy aliases are still accepted: PYMTHOUSE_PUBLIC_CLIENT_ID or
# PYMTHOUSE_CLIENT_ID. Do not set a machine-client secret in ComfyUI.
