# Example environment config for Livepeer network

# Orchestrator URL (required)
ORCHESTRATOR_URL=https://hky.eliteencoder.net:8936

# Signer URL used when nobody is signed in to PymtHouse (optional)
SIGNER_URL=http://localhost:8081

# PymtHouse public OIDC client. PYMTHOUSE_CLIENT_ID is the public app_ id
# (not a secret). The app must allow the device-code and refresh-token grants
# and the scopes "openid" and "sign:job". Leave third-party initiate login off.
PYMTHOUSE_ISSUER_URL=https://your-pymthouse.example/api/v1/oidc
PYMTHOUSE_CLIENT_ID=
